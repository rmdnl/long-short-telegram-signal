# Telegram Configuration
# TELEGRAM_ENABLED controls whether the bot sends messages via Telegram API.
# Default is false (disabled). Set to true to enable delivery.
TELEGRAM_ENABLED=false
# When enabled, these are required:
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Application Mode
SIGNAL_ONLY=true
DRY_RUN=false
QUALITY_MODE=true
SEND_WATCH_SIGNALS=false

# Strategy Parameters
ADX_LENGTH=14
ADX_MIN=22

RSI_LENGTH=14
RSI_MIDLINE=50

EMA_FAST=50
EMA_SLOW=200

ATR_LENGTH=14
SL_ATR_MULTIPLIER=1.5

TP1_RR=1.5
TP2_RR=2.5

VOLUME_SMA_LENGTH=20
VOLUME_MULTIPLIER=1.2

MIN_SCORE=80

MAX_DISTANCE_FROM_EMA_ATR=2.0

COOLDOWN_CANDLES=3

MAX_DATA_AGE_SECONDS=30

# Rate-Limit Safety (PHASE 3 dry-run)
# HTTP request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=10
# Max retries for transient network / 5xx / 429 errors
MAX_RETRIES=3
# Base delay (seconds) for exponential backoff (doubles each retry)
BACKOFF_BASE_SECONDS=1

# Scanning
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT
SCAN_INTERVAL_SECONDS=60

# Logging
LOG_LEVEL=INFO
